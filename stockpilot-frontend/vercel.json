{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/index.html" },
    { "source": "/products", "destination": "/index.html" },
    { "source": "/sales", "destination": "/index.html" },
    { "source": "/orders", "destination": "/index.html" },
    { "source": "/orders/:id", "destination": "/index.html" },
    { "source": "/categories", "destination": "/index.html" },
    { "source": "/suppliers", "destination": "/index.html" }
  ]
}
