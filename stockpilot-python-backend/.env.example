# Supabase Session Pooler (IPv4 compatible) connection string for Render.
# Use the Session pooler host shown in Supabase > Connect, port 5432.
# Replace placeholders locally; URL-encode special characters in the password. Never commit a populated .env file.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated origins; include the deployed Vercel frontend and local dev URL.
FRONTEND_ORIGINS=https://your-stockpilot.pages.dev,http://localhost:5173
ENVIRONMENT=development
SESSION_COOKIE_NAME=stockpilot_session
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_MAX_AGE_SECONDS=604800
